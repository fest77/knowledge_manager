# knowledge_manager - 环境变量模板（复制为 .env 后填写）

# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=   # 原值长度 10
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=   # 原值长度 1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=   # 原值长度 29
# Hugging Face 缓存路径
HF_HOME=   # 原值长度 30
# 临时文件根目录
MD_ROOT_DIR=   # 原值长度 13

# mineru api以及url处理地址！
MINERU_API_TOKEN=   # 原值长度 51
MINERU_BASE_URL=   # 原值长度 25

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=   # 原值长度 115
DASHSCOPE_API_KEY=   # 原值长度 115
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=   # 原值长度 49
# 默认 LLM 模型
LLM_DEFAULT_MODEL=   # 原值长度 10
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=   # 原值长度 3
# 视觉语言模型
VL_MODEL=   # 原值长度 14
# 商品名识别模型
ITEM_MODEL=   # 原值长度 10

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=   # 原值长度 48
# BGE-M3 模型名称
BGE_M3=   # 原值长度 11
# 嵌入模型运行设备
BGE_DEVICE=   # 原值长度 17
# BGE-M3 是否开启 FP16 半精度推理，1=开启（GPU加速更高效），0=关闭（兼容低版本GPU/CPU）
BGE_FP16=   # 原值长度 1
# BGE 重排序模型路径
BGE_RERANKER_LARGE=   # 原值长度 60
# 重排序模型设备
BGE_RERANKER_DEVICE=   # 原值长度 6
# 重排序模型半精度
BGE_RERANKER_FP16=   # 原值长度 1
# 项目名称诊断标志
ITEM_NAME_DIAG=   # 原值长度 1

# ====================
# Embedding General
# ====================
# 嵌入向量维度（OpenAI text-embedding-v4）
EMBEDDING_DIM=   # 原值长度 4
# 嵌入模型名称
EMBEDDING_MODEL=   # 原值长度 17

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=   # 原值长度 26
# 知识库切片集合名
CHUNKS_COLLECTION=   # 原值长度 12
# 商品名称集合名
ITEM_NAME_COLLECTION=   # 原值长度 16
# 相似度度量方式
MILVUS_METRIC_TYPE=   # 原值长度 6
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=   # 原值长度 4
# Milvus认证配置（如果启用了认证）
# MILVUS_USER=root
# MILVUS_PASSWORD=Milvus

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=   # 原值长度 29
# 数据库名
MONGO_DB_NAME=   # 原值长度 5

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=   # 原值长度 18
# 访问密钥
MINIO_ACCESS_KEY=   # 原值长度 10
# 私有密钥
MINIO_SECRET_KEY=   # 原值长度 10
# 存储桶名称
MINIO_BUCKET_NAME=   # 原值长度 20

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
#MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
MCP_DASHSCOPE_BASE_URL=   # 原值长度 56

# ====================
# 应用自身（knowledge_manager）
# ====================
# JWT 签名密钥（HS256）：必须 >= 32 字节，且**不要提交真实值**
JWT_SECRET=   # 必填，用密钥管理服务注入
JWT_ALGORITHM=HS256
JWT_ISSUER=knowledge_manager
JWT_EXPIRE_SECONDS=43200
BCRYPT_ROUNDS=12
KM_LOG_LEVEL=INFO

# ====================
# 模块 10 审计日志（全部有默认值；不配也能跑）
# ====================
AUDIT_SPOOL_DIR=var/audit_spool
AUDIT_INSERT_TIMEOUT_MS=500
AUDIT_RETRY_BACKOFF_MS=50
AUDIT_BREAKER_THRESHOLD=5
AUDIT_BREAKER_SECONDS=60
AUDIT_REPLAY_INTERVAL_SECONDS=300
AUDIT_SNAPSHOT_LIMIT_BYTES=16384
AUDIT_EXPORT_MAX_ROWS=50000
AUDIT_EXPORT_BATCH=500
AUDIT_QUERY_MAX_DEPTH=10000
AUDIT_QUERY_MAX_SPAN_DAYS=366
